# AuditCore — dépôt produit
node_modules/

# Sorties régénérables (RAF-028) : les kits OFFICIELS d'un engagement vivent
# dans l'espace du tenant (son dossier de livrables), jamais ici.
deliverables/generated/

# Sous-produits de fusion/test locaux
config/merged.json
tests/fixtures/merged.json
tests/fixtures/theme/

# Sorties des oracles projet (rapports régénérables, jamais versionnés)
oracles/versions-actuelles.json
oracles/*.remediation-plan.json

# Sous-produits de build par tenant (regénérables par build-theme / merge-packs)
config/tenants/*/merged.json
config/tenants/*/theme/

# journaux du hook qualité (TF-0065) : sidecars d'oracles hors dépôt — les preuves
# vivent dans les rapports et les recettes, pas en fichiers regénérables à la racine
*.oracles.json
*.oracles-cache.json
*.oracles-historique.jsonl