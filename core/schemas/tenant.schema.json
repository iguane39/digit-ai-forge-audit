{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "auditcore/tenant.schema.json",
  "title": "AuditCore tenant.yaml",
  "type": "object",
  "required": ["schema_version", "core_version", "tenant", "branding", "domains", "dimensions", "constraint_packs", "enforcement"],
  "properties": {
    "schema_version": { "const": 1 },
    "core_version": { "type": "string", "minLength": 1 },
    "tenant": {
      "type": "object",
      "required": ["name", "short_code", "language"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "short_code": { "type": "string", "pattern": "^[A-Z]{1,3}$" },
        "parent_org": { "type": ["string", "null"] },
        "language": { "enum": ["fr", "en"] }
      }
    },
    "branding": {
      "type": "object",
      "properties": {
        "design_md": { "type": "string" },
        "logo": { "type": "string" },
        "favicon_letter": { "type": "string", "maxLength": 2 },
        "colors": {
          "type": "object",
          "properties": {
            "accent": { "$ref": "#/definitions/hex" },
            "fatal": { "$ref": "#/definitions/hex" },
            "bloquant": { "$ref": "#/definitions/hex" },
            "majeur": { "$ref": "#/definitions/hex" },
            "standard": { "$ref": "#/definitions/hex" }
          },
          "additionalProperties": { "$ref": "#/definitions/hex" }
        },
        "typography": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "anyOf": [ { "required": ["design_md"] }, { "required": ["colors"] } ]
    },
    "domains": {
      "type": "array", "minItems": 9, "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["code", "key", "label"],
        "properties": {
          "code": { "type": "string", "pattern": "^0[0-9]$" },
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string" },
          "color": { "$ref": "#/definitions/hex" }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "required": ["pack"],
      "properties": {
        "pack": { "type": "string" },
        "relabel": { "type": "object", "propertyNames": { "pattern": "^D(0[0-9]|1[0-6])$" }, "additionalProperties": { "type": "string" } },
        "principles_pack": { "type": "string" }
      }
    },
    "profiles": { "type": "array", "items": { "type": "string" } },
    "jurisdictions": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "description": "packs réglementaires actifs (RAF-011) ; contrôles marqués d'une autre juridiction → sans_objet motivé à la fusion" },
    "constraint_packs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "adr": {
      "type": "object",
      "properties": {
        "id_scheme": { "enum": ["domain-coded"] },
        "aliases": { "type": "object", "additionalProperties": { "type": "string" } },
        "overrides": {
          "type": "object",
          "properties": {
            "add": { "type": "array", "items": { "type": "string" } },
            "tighten": { "type": "object", "additionalProperties": { "type": "object", "properties": { "enforcement": { "$ref": "#/definitions/enforcement" } } } },
            "disable": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "enforcement": {
      "type": "object",
      "required": ["binding_authorities"],
      "properties": {
        "binding_authorities": { "type": "array", "items": { "type": "string" }, "minItems": 0 },
        "gate_policy": { "type": "object" }
      }
    },
    "environments": {
      "type": "array",
      "items": { "type": "object", "required": ["key", "label"], "properties": { "key": {}, "label": {}, "zone": {}, "code": {}, "owner": {} } }
    },
    "roles": { "type": "object", "additionalProperties": { "type": ["string", "object"] } },
    "sources": { "type": "array" },
    "forge": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "repo_provider": { "enum": ["github", "azure-devops"] },
        "brand_charter": { "type": "string" }
      }
    }
  },
  "definitions": {
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
    "enforcement": { "enum": ["blocking", "required", "advisory", "recommendation"] }
  }
}
